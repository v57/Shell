<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What Xcode can't generate from a build setting; the rest of the iOS app's Info.plist is generated. -->
	<!-- Animations and scrolling at up to 120 fps on an iPhone with ProMotion; without it they stop at 60. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>Confirms it's you before this device's SSH key signs in to a server.</string>
	<!-- ComponentKit's QR scanner is linked even where no screen shows it, and App Store Connect rejects a build that
	     references the camera without a reason (ITMS-90683). -->
	<key>NSCameraUsageDescription</key>
	<string>Shell uses the camera only when you choose to scan a QR code.</string>
</dict>
</plist>
